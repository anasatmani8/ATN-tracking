# Copy to .env.local. Nothing here is secret; never put a service-role key in the app.

# Branding / identifiers (all optional; defaults are placeholders)
APP_NAME=Kinset
APP_SLUG=kinset
APP_SCHEME=kinset
IOS_BUNDLE_ID=com.example.kinset
ANDROID_PACKAGE=com.example.kinset
SUPPORT_EMAIL=
PRIVACY_URL=
TERMS_URL=
ACCOUNT_DELETION_URL=
EAS_PROJECT_ID=

# Cloud sync (optional). Leave empty for a local-only build: account UI is hidden.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Barcode provider (optional). "off" keeps lookups local. "openfoodfacts" enables the live
# provider — only after the publisher has reviewed its licence (ODbL), attribution and privacy terms.
EXPO_PUBLIC_BARCODE_PROVIDER=off
